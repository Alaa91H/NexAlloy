<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/morphe_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/morphe_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/morphe_background"
        android:elevation="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/morphe_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/morphe_surface"
        android:elevation="12dp"
        android:minHeight="72dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:itemIconTint="@color/morphe_nav_item_color"
        app:itemTextColor="@color/morphe_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/morphe_main_navigation" />

</LinearLayout>
